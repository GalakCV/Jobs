# Copie para .env e preencha apenas o que for usar. Nada aqui é obrigatório.

# E-mail de contato enviado no User-Agent (boa prática para APIs públicas).
CRAWLER_CONTACT=voce@exemplo.com

# Discord: Configurações do canal > Integrações > Webhooks > Copiar URL
DISCORD_WEBHOOK_URL=

# Telegram: crie um bot com @BotFather e pegue o chat_id com @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Notion: crie uma integração em https://www.notion.so/my-integrations,
# compartilhe o banco de dados com ela e cole o ID do banco (32 caracteres da URL).
NOTION_TOKEN=
NOTION_DATABASE_ID=
